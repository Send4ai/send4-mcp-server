{
    "name": "list_conversations",
    "title": "List conversations",
    "description": "Lists the inbox, most recently active first, 50 a page, filtered like the Conversations page. Each row:\nstatus and why, channel kind, flow and run, owner, when it last moved, and the customer: name only with\nthe conversation-content permission, contact details always masked. No message text: `read_conversation`\nhas it, and `explain_conversation` says why one went as it did.",
    "inputSchema": {
        "properties": {
            "status": {
                "description": "Any of these.",
                "items": {
                    "type": "string"
                },
                "type": "array"
            },
            "assigned": {
                "description": "\"me\", \"unassigned\" or a member id.",
                "type": "string"
            },
            "flow_id": {
                "description": "From `list_flows`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "campaign_id": {
                "description": "From `list_campaigns`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "channel_type": {
                "description": "`sms`, `email`, `web_widget` or `email_inbox`.",
                "items": {
                    "type": "string"
                },
                "type": "array"
            },
            "replied": {
                "description": "true: the customer wrote at least once.",
                "type": "boolean"
            },
            "meeting_booked": {
                "description": "true: a meeting is still scheduled.",
                "type": "boolean"
            },
            "search": {
                "description": "Name, phone or email.",
                "type": "string"
            },
            "date_from": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "date_to": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "limit": {
                "description": "Rows a page, at most 100. Default 50.",
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
            },
            "page": {
                "description": "From 1.",
                "minimum": 1,
                "type": "integer"
            }
        },
        "type": "object"
    },
    "annotations": {
        "title": "List conversations",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
