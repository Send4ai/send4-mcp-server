{
    "name": "create_mailbox",
    "title": "Create an email address",
    "description": "Creates an email address on Send4, on a domain `get_mailbox_setup` offers. It sends nothing until a flow\nor a campaign uses it. An address already in use is refused, so a repeat creates nothing.",
    "inputSchema": {
        "properties": {
            "name": {
                "description": "The part before the @.",
                "type": "string"
            },
            "domain": {
                "description": "From `get_mailbox_setup`; the first by default.",
                "type": "string"
            },
            "display_name": {
                "description": "The sender name.",
                "type": "string"
            }
        },
        "type": "object",
        "required": [
            "name"
        ]
    },
    "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false,
        "idempotentHint": false
    }
}
