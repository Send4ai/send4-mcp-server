{
    "name": "create_lead",
    "title": "Add a lead",
    "description": "Add one lead, optionally tagged. The phone is required; without a + it is read in the workspace's country\nunless `country` says otherwise. A number that is already a lead is refused. It sends nothing.",
    "inputSchema": {
        "properties": {
            "phone": {
                "description": "With a +, or local to `country`.",
                "type": "string"
            },
            "country": {
                "description": "ISO 3166 two-letter code, e.g. LT.",
                "type": "string"
            },
            "first_name": {
                "description": "Given name.",
                "type": "string"
            },
            "last_name": {
                "description": "Family name.",
                "type": "string"
            },
            "email": {
                "description": "Their email address.",
                "type": "string"
            },
            "tag_ids": {
                "description": "From `list_leads`' `tags`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            }
        },
        "type": "object",
        "required": [
            "phone"
        ]
    },
    "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false,
        "idempotentHint": false
    }
}
