{
    "name": "create_campaign",
    "title": "Create a campaign draft",
    "description": "Create a campaign as a draft: which active flow it sends, from which number or mailbox, and to whom:\nleads by id, everyone with some tags, a pasted list, or the people of an earlier campaign\n(`copy_from_campaign_id` with `copy_scope`). Nothing is sent. An email campaign needs a `subject`. A\n`goal` is any card outcome of the flow except failed, with an optional target; without one it uses\nthe flow's booking, if it books.",
    "inputSchema": {
        "properties": {
            "name": {
                "description": "Shown on the Campaigns page.",
                "type": "string"
            },
            "flow_id": {
                "description": "An active flow with a campaign trigger.",
                "type": "integer"
            },
            "channel_id": {
                "description": "The number or mailbox it sends from, from `list_channels`.",
                "type": "integer"
            },
            "subject": {
                "description": "Email only: the first email's subject.",
                "type": "string"
            },
            "lead_ids": {
                "description": "From `list_leads`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "tag_ids": {
                "description": "Up to 10.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "tag_match": {
                "description": "With several tags: leads with `any` (default) or `all` of them.",
                "enum": [
                    "any",
                    "all"
                ],
                "type": "string"
            },
            "pasted_recipients": {
                "description": "One recipient per line.",
                "type": "string"
            },
            "copy_from_campaign_id": {
                "description": "Run a finished campaign again. Not with lead_ids or pasted_recipients.",
                "type": "integer"
            },
            "copy_scope": {
                "description": "Who of that campaign: everyone, those not reached, or those who never replied.",
                "enum": [
                    "all",
                    "not_reached",
                    "not_replied"
                ],
                "type": "string"
            },
            "goal": {
                "description": "`card_id` and `outcome` from `read_flow`, optional `target`.",
                "properties": {
                    "card_id": {
                        "type": "integer"
                    },
                    "outcome": {
                        "type": "string"
                    },
                    "target": {
                        "type": "integer"
                    }
                },
                "type": "object"
            }
        },
        "type": "object",
        "required": [
            "name",
            "flow_id",
            "channel_id"
        ]
    },
    "annotations": {
        "title": "Create a campaign draft",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false,
        "idempotentHint": false
    }
}
