{
    "name": "get_performance",
    "title": "Conversation performance",
    "description": "Reads the Analytics Performance page: conversations started, replied, gave the details asked for, and\nbooked, what it cost, and how those moved over time, for a date range and filters, per flow with\n`breakdown` and against the previous period with `compare`. By default the last 30 days by week, in UTC\ndays. `conversations_started` counts conversations a flow or person sent to; `reply_rate_pct` is the\nshare who answered. Costs are at the workspace's own SMS price. `whole_period: false` marks a bucket the\nrange or today cuts short. `totals` counts each conversation once, so it is not the sum of the buckets.\nRehearsals never count. `get_drop_off` shows where conversations stop.",
    "inputSchema": {
        "properties": {
            "from": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "to": {
                "description": "Inclusive, at most 366 days after `from`.",
                "type": "string"
            },
            "interval": {
                "description": "Bucket size.",
                "enum": [
                    "day",
                    "week",
                    "month"
                ],
                "type": "string"
            },
            "compare": {
                "description": "Also the period of the same length just before.",
                "type": "boolean"
            },
            "flow_id": {
                "description": "From `list_flows`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "channel_id": {
                "description": "From `list_channels`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "campaign_id": {
                "description": "From `list_campaigns`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "assigned_user_id": {
                "description": "Conversation owners, from `list_members`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "trigger_type": {
                "description": "Trigger types, e.g. `webhook` or `campaign`.",
                "items": {
                    "type": "string"
                },
                "type": "array"
            },
            "direction": {
                "description": "The page's Direction filter.",
                "enum": [
                    "inbound",
                    "outbound"
                ],
                "type": "string"
            },
            "channel_type": {
                "description": "Channel kinds.",
                "items": {
                    "enum": [
                        "sms",
                        "email",
                        "web_widget"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "breakdown": {
                "description": "`flow` adds one row per flow.",
                "enum": [
                    "flow"
                ],
                "type": "string"
            }
        },
        "type": "object"
    },
    "annotations": {
        "title": "Conversation performance",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
