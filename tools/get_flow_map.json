            }
        },
        "type": "object",
        "required": [
            "flow_id"
        ]
    },
    "annotations": {
        "title": "Draw a flow map",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    },
    "_meta": {
