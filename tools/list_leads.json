{
    "name": "list_leads",
    "title": "List leads",
    "description": "The workspace's leads, newest first, 50 a page, filtered like the Leads page.\nAlso every tag with how many leads carry it. Phones and emails are always masked; names and list\ncolumns are shown only with the conversation-content permission. `total` counts every match, not this\npage.",
    "inputSchema": {
        "properties": {
            "search": {
                "description": "Phone, first or last name, or email.",
                "type": "string"
            },
            "tag_ids": {
                "description": "From this answer's `tags`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "source": {
                "description": "`import`: added by a spreadsheet import.",
                "enum": [
                    "import",
                    "other"
                ],
                "type": "string"
            },
            "sms": {
                "description": "Whether the number opted out of SMS.",
                "enum": [
                    "opted_out",
                    "not_opted_out"
                ],
                "type": "string"
            },
            "limit": {
                "description": "Rows a page, at most 100. Default 50.",
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
            },
            "page": {
                "description": "From 1.",
                "minimum": 1,
                "type": "integer"
            }
        },
        "type": "object"
    },
    "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
