{
    "name": "get_message_usage",
    "title": "Message usage",
    "description": "Reads the Analytics Messages page: messages and SMS parts sent and received in a range (this month by\ndefault), their cost at the workspace's SMS price, the monthly SMS-part limit and how much is used, a\nseries, and a breakdown by `group_by`. UTC days, as on the page. `get_account_usage` has every plan cap;\n`get_performance` counts conversations and bookings.",
    "inputSchema": {
        "properties": {
            "from": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "to": {
                "description": "Inclusive, at most 366 days after `from`.",
                "type": "string"
            },
            "interval": {
                "description": "Bucket size.",
                "enum": [
                    "day",
                    "week",
                    "month"
                ],
                "type": "string"
            },
            "compare": {
                "description": "Also the period of the same length just before.",
                "type": "boolean"
            },
            "flow_id": {
                "description": "From `list_flows`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "channel_id": {
                "description": "From `list_channels`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "campaign_id": {
                "description": "From `list_campaigns`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "assigned_user_id": {
                "description": "Conversation owners, from `list_members`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "trigger_type": {
                "description": "Trigger types, e.g. `webhook` or `campaign`.",
                "items": {
                    "type": "string"
                },
                "type": "array"
            },
            "direction": {
                "description": "The page's Direction filter.",
                "enum": [
                    "inbound",
                    "outbound"
                ],
                "type": "string"
            },
            "channel_type": {
                "description": "Channel kinds.",
                "items": {
                    "enum": [
                        "sms",
                        "email",
                        "web_widget"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "group_by": {
                "description": "Defaults to channel.",
                "enum": [
                    "channel",
                    "flow",
                    "campaign"
                ],
                "type": "string"
            }
        },
        "type": "object"
    },
    "annotations": {
        "title": "Message usage",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
