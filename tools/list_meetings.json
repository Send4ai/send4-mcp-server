{
    "name": "list_meetings",
    "title": "Meetings",
    "description": "Up to 50 meetings, soonest first: when, how long, what kind, where, status, conversation and whose it is. Filter by\n`status`, `date_from` and `date_to` (workspace days) and `owner` (\"me\", \"unassigned\" or a member id). The customer's\nname needs the conversation-content permission.",
    "inputSchema": {
        "properties": {
            "status": {
                "description": "Only meetings in this state.",
                "enum": [
                    "scheduled",
                    "completed",
                    "cancelled",
                    "no_show"
                ],
                "type": "string"
            },
            "date_from": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "date_to": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "owner": {
                "description": "\"me\", \"unassigned\" or a member id.",
                "type": "string"
            }
        },
        "type": "object"
    },
    "annotations": {
        "title": "Meetings",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
