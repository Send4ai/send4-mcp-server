{
    "name": "list_campaigns",
    "title": "List campaigns",
    "description": "The campaigns, newest first, 25 a page: status, flow, sender, pace, sending hours, progress and results. Archived ones are\nleft out unless `archived` says otherwise. Live campaigns and drafts are listed whatever the dates; `from` and `to` narrow the\nothers by when they started, in the workspace's timezone.",
    "inputSchema": {
        "properties": {
            "status": {
                "description": "Any of these.",
                "items": {
                    "enum": [
                        "draft",
                        "scheduled",
                        "running",
                        "paused",
                        "completed",
                        "cancelled"
                    ],
                    "type": "string"
                },
                "type": "array"
            },
            "flow_id": {
                "description": "From `list_flows`.",
                "items": {
                    "type": "integer"
                },
                "type": "array"
            },
            "from": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "to": {
                "description": "YYYY-MM-DD",
                "type": "string"
            },
            "archived": {
                "description": "Default `exclude`.",
                "enum": [
                    "exclude",
                    "only",
                    "include"
                ],
                "type": "string"
            },
            "limit": {
                "description": "Rows a page, at most 100. Default 25.",
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
            },
            "page": {
                "description": "From 1.",
                "minimum": 1,
                "type": "integer"
            }
        },
        "type": "object"
    },
    "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    }
}
