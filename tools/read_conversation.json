{
    "name": "read_conversation",
    "title": "Read a conversation",
    "description": "What was said in one conversation, the newest page first and oldest first within the page. `next_cursor` as\n`cursor` reads further back. `message_count` is the whole\nconversation. Contact details are masked; bodies are not, and one over 8,000 characters says `body_cut`. `run_id`\nnarrows to the time around one flow run, marked `approximate`, so a per-run count is never exact.",
    "inputSchema": {
        "properties": {
            "conversation_id": {
                "description": "From `list_conversations`.",
                "minimum": 1,
                "type": "integer"
            },
            "limit": {
                "description": "Messages a page, at most 100. Default 50.",
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
            },
            "cursor": {
                "description": "`next_cursor` of the previous page.",
                "minimum": 1,
                "type": "integer"
            },
            "run_id": {
                "description": "From `list_flow_runs`.",
                "minimum": 1,
                "type": "integer"
            }
        },
        "type": "object",
        "required": [
            "conversation_id"
        ]
    },
    "annotations": {
        "title": "Read a conversation",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
    },
    "_meta": {
        "ui": {
            "resourceUri": "ui://resources/conversation-thread-app",
            "visibility": [
                "model",
                "app"
            ]
        }
    }
}
